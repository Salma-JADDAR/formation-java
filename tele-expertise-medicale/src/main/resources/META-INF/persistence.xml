<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="teleExpertisePU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.telexpertise.entity.User</class>
        <class>org.telexpertise.entity.Infirmier</class>
        <class>org.telexpertise.entity.Generaliste</class>
        <class>org.telexpertise.entity.Specialiste</class>
        <class>org.telexpertise.entity.Patient</class>
        <class>org.telexpertise.entity.DossierMedical</class>
        <class>org.telexpertise.entity.SigneVital</class>
        <class>org.telexpertise.entity.Specialite</class>
        <class>org.telexpertise.entity.Creneau</class>
        <class>org.telexpertise.entity.Consultation</class>
        <class>org.telexpertise.entity.DemandeExpertise</class>
        <class>org.telexpertise.entity.Prescription</class>
        <class>org.telexpertise.entity.ActeMedical</class>
        <class>org.telexpertise.entity.PassagePatient</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/telexpertise?useSSL=false&amp;serverTimezone=UTC"/>

            <property name="jakarta.persistence.jdbc.user" value="root"/>

            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.show_sql" value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>